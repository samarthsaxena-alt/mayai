# --- PyAI ---
# Sandbox key for dev (pyai_test_...): curl -sX POST https://api.pyai.com/v1/sandbox/keys -H "Content-Type: application/json" -d '{"label":"open-receptionist"}'
# Live key (pyai_live_...) is required for a real phone number (console.pyai.com).
PYAI_API_KEY=pyai_test_xxxxxxxxxxxxxxxxxxxxxxxx
PYAI_BASE_URL=https://api.pyai.com

# --- Server ---
PORT=8080
# Public host Twilio (or PyAI, if using the Twilio-bridge fallback path) can reach.
# If unset, uses the incoming Host header (fine behind ngrok).
# PUBLIC_HOST=your-subdomain.ngrok.app

# Shared secret the PyAI tool-executor sends back to us on every tool webhook call.
# Set this to any long random string; used as auth_secret when we register tools.
TOOL_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Twilio (only needed for the bring-your-own-number fallback path) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# HUMAN_NUMBER=+15551230000
